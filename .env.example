# Plantilla de variables de entorno locales para DIANA Inversions
# Copiar este archivo a .env y completar los valores localmente.
# NUNCA subir .env a Git ni compartir secretos.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=tu-service-role-key-secreta
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=diana_demo

